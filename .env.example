# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Gemini (optional). Without it, /api/report serves the cached demo report.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# HydraDB (optional). Without it, ripple/store.py uses LocalStore.
HYDRA_DB_API_KEY=
HYDRA_DB_DATABASE=ripple-brain
HYDRA_DB_COLLECTION=ripple_docs
